{
  "name": "nova-ui-kit",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "A modern Tauri + React desktop UI editor with project, Rust logic, and exe build workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorrowfeng/nova-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/sorrowfeng/nova-ui-kit/issues"
  },
  "homepage": "https://github.com/sorrowfeng/nova-ui-kit#readme",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:components && npm run check:experience && npm run check:showcase-size && npm run check:builder-file-size && npm run check:command-reachability && tsc && vite build && npm run check:bundle-size",
    "check:components": "node scripts/check-component-coverage.mjs",
    "check:experience": "node scripts/check-editor-experience.mjs && npm run check:command-reachability && npm run check:runtime-contract && npm run check:project-persistence && npm run check:goal && npm run version:check && npm run check:platform-bundle && npm run check:release-artifact-magic && npm run check:project-file-models && npm run check:english-prose-rules && npm run check:english-prose && npm run check:ui-density-rules && npm run check:ui-density && npm run check:builder-runtime",
    "check:goal": "node scripts/check-goal-coverage.mjs",
    "check:runtime-contract": "node scripts/check-generated-runtime-contract.mjs",
    "check:project-persistence": "node scripts/check-project-persistence-rust.mjs",
    "check:generated-runtime": "node scripts/check-generated-runtime-rust.mjs",
    "check:desktop-exe": "node scripts/check-desktop-exe.mjs",
    "check:builder-runtime": "node scripts/check-builder-runtime-functional.mjs",
    "verify:desktop": "node scripts/verify-desktop-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:exe": "tauri build --no-bundle",
    "check:showcase-size": "node scripts/check-showcase-size.mjs",
    "check:builder-file-size": "node scripts/check-builder-file-size.mjs",
    "check:command-reachability": "node scripts/check-command-reachability.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "version:set": "node scripts/set-version.mjs",
    "changelog": "node scripts/update-changelog.mjs",
    "release:prepare": "node scripts/set-version.mjs && node scripts/update-changelog.mjs",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "docs:deploy": "npm run docs:site",
    "docs:screenshots": "node scripts/capture-workspace-screenshots.mjs",
    "check:cpp-ffi": "node scripts/check-cpp-ffi-sample.mjs",
    "check:project-health": "node scripts/check-project-health.mjs",
    "check:watch": "node scripts/check-watch.mjs",
    "check:builder-runtime:design": "node scripts/check-builder-runtime-design.mjs",
    "check:builder-runtime:full": "node scripts/check-builder-runtime-smoke.mjs",
    "check:builder-runtime:layout": "node scripts/check-builder-runtime-layout.mjs",
    "check:builder-runtime:functional": "node scripts/check-builder-runtime-functional.mjs",
    "docs:search": "node scripts/docs-search.mjs",
    "docs:site": "node scripts/docs-site.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:platform-bundle": "node scripts/check-platform-bundle-config.mjs",
    "check:release-artifact-magic": "node scripts/check-release-artifact-magic.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:ui-density": "node scripts/check-ui-density.mjs",
    "check:ui-density-rules": "node --experimental-strip-types scripts/check-ui-density-rules.mjs",
    "check:ui-density:report": "node scripts/check-ui-density.mjs --report",
    "check:project-file-models": "node scripts/check-project-file-models.mjs",
    "check:english-prose": "node scripts/check-english-prose.mjs",
    "check:english-prose-rules": "node scripts/check-english-prose-rules.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.8.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
