{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova UI Editor",
  "version": "0.1.0",
  "identifier": "com.nova.ui-kit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nova UI 编辑器",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 720,
        "maximized": true,
        "decorations": false,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Nova UI Kit",
    "shortDescription": "Nova UI Editor — desktop visual Tauri app editor",
    "longDescription": "Desktop-first UI editor and component workbench built with Tauri and React.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
